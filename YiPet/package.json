{
  "name": "yipet",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":        "vite build --mode development --watch",
    "build":      "npm run build:cdn && vite build",
    "build:cdn":  "vite build --config vite.cdn.config.ts",
    "typecheck":  "tsc --noEmit",
    "clean":      "rm -rf dist public/cdn/utils/index.js",
    "test":       "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
