{
  "name": "yipet",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:cdn && (rsbuild build --mode development --watch & rsbuild build --mode production --watch --config rsbuild.config.chat.ts & rsbuild build --mode development --watch --config rsbuild.config.bootstrap.ts)",
    "build": "npm run build:cdn && rsbuild build && npm run build:chat && npm run build:bootstrap",
    "build:cdn": "rsbuild build --config rsbuild.config.cdn.ts",
    "build:chat": "rsbuild build --config rsbuild.config.chat.ts",
    "build:bootstrap": "rsbuild build --config rsbuild.config.bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "antd": "^5.21.0",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
