{
  "name": "yipet",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:cdn && (rsbuild build --mode development --watch & rsbuild build --mode production --watch --config rsbuild.config.chat.ts & rsbuild build --mode development --watch --config rsbuild.config.bootstrap.ts)",
    "build": "npm run build:cdn && rsbuild build && npm run build:chat && npm run build:bootstrap",
    "build:cdn": "rsbuild build --config rsbuild.config.cdn.ts",
    "build:chat": "rsbuild build --config rsbuild.config.chat.ts",
    "build:bootstrap": "rsbuild build --config rsbuild.config.bootstrap.ts",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:eslint": "eslint --fix --ext .js,.ts,.vue ./src",
    "lint:prettier": "prettier --write \"src/**/*.{js,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky install",
    "commit": "git add -A && czg && git push"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.3",
    "marked": "^15.0.12",
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^1.0.0",
    "@rsbuild/plugin-sass": "^1.0.0",
    "@rsbuild/plugin-vue": "^1.0.0",
    "@rsbuild/plugin-vue-jsx": "^1.0.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.5.4",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^2.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}