  "aboutTitle": { "message": "About YiPet" },
  "aboutTagline": { "message": "A gentle interactive companion that lives in your browser — chat, play, and stay company while you browse." },
  "aboutDescription": { "message": "YiPet is a Chrome Manifest V3 extension that injects an animated companion into any web page. It supports multi-role AI chat powered by a local YiAi backend, a React-based control panel, on-demand CDN resource injection, and full i18n with timezone-aware display." },
  "aboutFeaturesTitle": { "message": "Highlights" },
  "aboutFeaturePet": { "message": "Animated pet on any page" },
  "aboutFeatureChat": { "message": "Multi-role AI chat window" },
  "aboutFeatureI18n": { "message": "English & 简体中文" },
  "aboutFeatureTimezone": { "message": "Timezone-aware display" },
  "aboutFeatureCDN": { "message": "On-demand CDN injection" },
  "aboutFeatureApi": { "message": "Four-tier API layer" },
  "aboutArchitectureTitle": { "message": "Architecture" },
  "aboutArchitectureDesc": { "message": "YiPet runs across two Chrome execution contexts (ISOLATED + MAIN world) and communicates with a local YiAi FastAPI backend. The popup, content scripts, and API layer form a clean three-tier stack." },
  "aboutArchLayerPopup": { "message": "Popup UI\n(React 15)" },
  "aboutArchLayerContent": { "message": "Content Script\n(MV3 Dual)" },
  "aboutArchLayerBackend": { "message": "YiAi API\n(FastAPI)" },
  "aboutBackendTitle": { "message": "Backend" },
  "aboutBackendDesc": { "message": "Powered by YiAi — a FastAPI server on localhost:10086 providing Ollama chat, file management, WeCom messaging, RSS aggregation, and a module-execution engine with MongoDB persistence." },
  "aboutProdDepsTitle": { "message": "Production Dependencies" },
  "aboutDevDepsTitle": { "message": "Development Dependencies" },
