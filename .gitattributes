# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Python
*.py text diff=python
*.pyi text diff=python
*.ipynb text

# TypeScript / JavaScript
*.ts text diff=typescript
*.tsx text diff=typescript
*.js text
*.mjs text
*.cjs text

# Vue SFC
*.vue text

# Config / data files
*.json text
*.yaml text
*.yml text
*.toml text
*.xml text
*.csv text

# Markdown / documentation
*.md text diff=markdown
*.mdx text diff=markdown

# Stylesheets
*.css text
*.scss text diff=css
*.less text

# Shell scripts
*.sh text eol=lf

# Web fonts (binary)
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary

# Archives / binaries
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Lock files
package-lock.json binary
pnpm-lock.yaml binary

# Environment files - never commit secrets
.env text
.env.* text
!.env.example text