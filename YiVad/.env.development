# Local environment
VITE_USER_NODE_ENV = development

# Public base path
VITE_PUBLIC_PATH = /

# Router mode
# Optional: hash | history
VITE_ROUTER_MODE = hash

# Remove console during build
VITE_DROP_CONSOLE = true

# Enable VitePWA
VITE_PWA = false

# Development environment API URL
VITE_API_URL = /api

# Development environment CORS proxy, forwards /api/* to YiAi backend
VITE_PROXY = [["/api","http://localhost:10086"]]
