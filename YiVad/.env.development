# Local environment
RSBUILD_ENV_USER_NODE_ENV = development

# Public base path
RSBUILD_ENV_PUBLIC_PATH = /

# Router mode
# Optional: hash | history
RSBUILD_ENV_ROUTER_MODE = hash

# Remove console during build
RSBUILD_ENV_DROP_CONSOLE = true

# Development environment API URL
RSBUILD_ENV_API_URL = /api

# Development environment CORS proxy, forwards /api/* to YiAi backend
RSBUILD_ENV_PROXY = [["/api","http://localhost:10086"],["/ollama","http://localhost:11434"]]

# Ollama model listing
RSBUILD_ENV_YIAI_OLLAMA_URL = http://localhost:11434
