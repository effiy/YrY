# Production environment
RSBUILD_ENV_USER_NODE_ENV = production

# Public base path
RSBUILD_ENV_PUBLIC_PATH = /

# Router mode
# Optional: hash | history
RSBUILD_ENV_ROUTER_MODE = hash

# Remove console during build
RSBUILD_ENV_DROP_CONSOLE = true

# Production environment API URL
RSBUILD_ENV_API_URL = "https://api.effiy.cn"

# Ollama model listing
RSBUILD_ENV_YIAI_OLLAMA_URL = https://ollama.effiy.cn
