# Production environment
VITE_USER_NODE_ENV = production

# Public base path
VITE_PUBLIC_PATH = /

# Router mode
# Optional: hash | history
VITE_ROUTER_MODE = hash

# Enable gzip or brotli compression for build, separate multiple rules with “,”
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS = none

# Delete original files after build compression
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# Remove console during build
VITE_DROP_CONSOLE = true

# Enable VitePWA
VITE_PWA = true

# Production environment API URL
VITE_API_URL = "https://mock.mengxuegu.com/mock/629d727e6163854a32e8307e"
