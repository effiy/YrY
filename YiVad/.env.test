# Test environment
RSBUILD_ENV_USER_NODE_ENV = test

# Public base path
RSBUILD_ENV_PUBLIC_PATH = /

# Router mode
# Optional: hash | history
RSBUILD_ENV_ROUTER_MODE = hash

# Remove console during build
RSBUILD_ENV_DROP_CONSOLE = true

# Test environment API URL
RSBUILD_ENV_API_URL = "http://localhost:10086"
