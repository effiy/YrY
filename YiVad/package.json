{
  "name": "yivad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "YiVad admin dashboard",
  "license": "MIT",
  "scripts": {
    "dev": "rsbuild dev",
    "serve": "rsbuild dev",
    "build:dev": "vue-tsc && rsbuild build --mode development",
    "build:test": "vue-tsc && rsbuild build --mode test",
    "build:pro": "vue-tsc && rsbuild build --mode production",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "preview": "pnpm build:dev && rsbuild preview",
    "lint:eslint": "eslint --fix --ext .js,.ts,.vue ./src",
    "lint:prettier": "prettier --write \"src/**/*.{js,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky install",
    "release": "standard-version",
    "commit": "git add -A && czg && git push"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.18.1",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^2.5.0",
    "dayjs": "^1.11.21",
    "driver.js": "^1.8.0",
    "echarts": "^6.1.0",
    "echarts-liquidfill": "^3.1.0",
    "element-plus": "^2.14.3",
    "marked": "^18.0.7",
    "md5": "^2.3.0",
    "mermaid": "^11.16.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.15.3",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^1.0.0",
    "@rsbuild/plugin-babel": "^1.0.0",
    "@rsbuild/plugin-sass": "^1.0.0",
    "@rsbuild/plugin-vue": "^1.0.0",
    "@rsbuild/plugin-vue-jsx": "^1.0.0",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.0.0",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.5.4",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "standard-version": "^9.5.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=16.18.0"
  },
  "browserslist": {
    "production": [
      "> 1%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
