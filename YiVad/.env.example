# YiVad Environment Variables
# Copy this file to .env and fill in your values.

# ── API ──
# YiAi backend base URL (used by Rsbuild dev proxy and production builds)
# RSBUILD_API_BASE=http://localhost:10086

# ── Build Mode ──
# RSBUILD_ENV_MODE=development   # development | test | production

# ── App ──
# RSBUILD_ENV_APP_TITLE=YiVad Admin
# RSBUILD_ENV_APP_VERSION=1.0.0