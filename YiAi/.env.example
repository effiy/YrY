# YiAi Environment Variables
# Copy this file to .env and fill in your values.
# These override settings in config.yaml.

# ── Server ──
# YIAI_SERVER_HOST=0.0.0.0
# YIAI_SERVER_PORT=10086

# ── MongoDB ──
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=ruiyi

# ── JWT ──
# JWT_SECRET=change-me-in-production
# JWT_EXPIRE_MINUTES=1440

# ── Auth (optional, disabled by default) ──
# MIDDLEWARE_AUTH_ENABLED=false
# MIDDLEWARE_AUTH_TOKEN=dev-token-change-me

# ── Ollama ──
# OLLAMA_URL=http://localhost:11434
# OLLAMA_AUTH=

# ── DeepSeek (OpenAI-compatible) ──
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ── LLM Provider Router ──
# LLM_CHAT_PROVIDER=ollama       # ollama | deepseek
# LLM_EMBED_PROVIDER=ollama      # ollama | deepseek
# AI_PROVIDER=ollama              # default fallback

# ── OSS ──
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_DOMAIN=