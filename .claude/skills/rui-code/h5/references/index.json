      "kind": "best-practices",
      "description": "16 mobile H5 best-practice topics (layered architecture, micro-frontends, JSBridge, style adaptation, error monitoring, offline packages, etc.), each with reference links and implementation code."
    },
    {
      "id": "newbee-mall-vue3-app",
      "label": "NewBee Mall Vue3 (New Bee Mall Vue3 Edition)",
      "readme": "references/README-newbee-mall-vue3-app.md",
